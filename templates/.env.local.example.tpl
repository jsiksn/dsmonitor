# dsmonitor 환경 변수 — 본 자료는 `dsmonitor init` 안 자동 생성됨 (v0.1.0).
# 사용 시: 본 자료를 dsmonitor/.env.local 로 cp 후 실제 값 입력.
# dsmonitor/.env.local 자체는 .gitignore 안 추가 권고 (민감 자료).

# ────── Figma (figmaAnalysis = true 시점에만) ──────
# FIGMA_API_TOKEN=figd_<personal access token>

# ────── Lighthouse (lighthouse 영역 활용 시점에만) ──────
# LIGHTHOUSE_BASE_URL=http://localhost:3000
# LIGHTHOUSE_TEST_ID=<선택, 인증 어댑터 영역 활용>
# LIGHTHOUSE_ZONE_ACCOUNT_LABEL=<선택>
